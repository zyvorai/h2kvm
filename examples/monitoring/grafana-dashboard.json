{
  "dashboard": {
    "id": null,
    "uid": "h2kvm-migrations",
    "title": "h2kvm Migration Dashboard",
    "tags": ["h2kvm", "migration", "kvm"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Migrations Total",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {"expr": "sum(h2kvm_migrations_total)", "legendFormat": "Total"}
        ],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [
          {"color": "green", "value": null},
          {"color": "yellow", "value": 10},
          {"color": "red", "value": 50}
        ]}}}
      },
      {
        "id": 2,
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {"expr": "sum(h2kvm_migrations_total{status='success'}) / sum(h2kvm_migrations_total) * 100", "legendFormat": "Success %"}
        ],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [
          {"color": "red", "value": null},
          {"color": "yellow", "value": 80},
          {"color": "green", "value": 95}
        ]}}}
      },
      {
        "id": 3,
        "title": "Average Speed (MB/s)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {"expr": "avg(h2kvm_migration_speed_mbps)", "legendFormat": "Avg MB/s"}
        ],
        "fieldConfig": {"defaults": {"unit": "MBs"}}
      },
      {
        "id": 4,
        "title": "Total Data Migrated",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {"expr": "sum(h2kvm_migration_size_bytes) / 1024 / 1024 / 1024", "legendFormat": "Total GB"}
        ],
        "fieldConfig": {"defaults": {"unit": "decgbytes"}}
      },
      {
        "id": 5,
        "title": "Migration Duration by VM",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {"expr": "h2kvm_migration_duration_seconds", "legendFormat": "{{vm_name}}"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 6,
        "title": "Migrations Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {"expr": "rate(h2kvm_migrations_total{status='success'}[5m])", "legendFormat": "Success/min"},
          {"expr": "rate(h2kvm_migrations_total{status='failure'}[5m])", "legendFormat": "Failure/min"}
        ]
      },
      {
        "id": 7,
        "title": "Active VMs (libvirt)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 12},
        "targets": [
          {"expr": "h2kvm_libvirt_vms_running", "legendFormat": "Running"}
        ]
      },
      {
        "id": 8,
        "title": "Disk Usage per VM",
        "type": "bargauge",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 12},
        "targets": [
          {"expr": "h2kvm_migration_size_bytes / 1024 / 1024 / 1024", "legendFormat": "{{vm_name}}"}
        ],
        "fieldConfig": {"defaults": {"unit": "decgbytes"}}
      },
      {
        "id": 9,
        "title": "Export Duration by Method",
        "type": "bargauge",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 12},
        "targets": [
          {"expr": "h2kvm_export_duration_seconds", "legendFormat": "{{method}} - {{vm_name}}"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      }
    ]
  }
}
