# hyper2kvm Tools Configuration Example
#
# Copy this file to ~/.config/hyper2kvm/tools.yaml or ./hyper2kvm-tools.yaml
# and customize for your environment
#
# Configuration is optional - tools work without it using sensible defaults

# Global settings
global:
  # Output directory for all reports (default: /tmp)
  output_dir: /var/lib/hyper2kvm/reports

  # Default output format (json, html, markdown, text)
  default_format: json

  # Enable verbose logging
  verbose: false

  # Number of parallel tools to run (for batch processing)
  parallel_jobs: 4

# Security audit configuration
security_audit:
  # Minimum acceptable security score (0-100)
  min_score: 70

  # Grade thresholds
  grade_thresholds:
    A: 90
    B: 80
    C: 70
    D: 60

  # Compliance checks to enable
  compliance_checks:
    - suid_binaries
    - writable_configs
    - unnecessary_services
    - journal_compression
    - coredump_restrictions

  # Report recipients (for email notifications)
  report_recipients:
    - security-team@example.com

  # Custom CSS for HTML reports
  html_css_file: /etc/hyper2kvm/custom.css

# Migration readiness configuration
migration_readiness:
  # Acceptable risk levels for automatic approval
  auto_approve_risk_levels:
    - minimal
    - low

  # Blocker checks to enforce
  mandatory_checks:
    - systemd_readiness
    - boot_configuration
    - network_configuration

  # Warning threshold (number of warnings to tolerate)
  max_warnings: 5

  # Exit code mapping
  exit_codes:
    ready_minimal: 0
    ready_low: 0
    ready_medium: 1
    ready_high: 1
    not_ready: 2

# Forensic analysis configuration
forensic_analysis:
  # Enable specific analysis categories
  categories:
    virtualization: true
    boot_performance: true
    security_analysis: true
    anomaly_detection: true
    crash_data: true
    failed_services: true
    network_config: true
    boot_config: true
    user_sessions: true
    migration_readiness: true
    advanced_config: true
    journal_analysis: true

  # Maximum coredumps to include in report
  max_coredumps: 10

  # Include boot timeline SVG
  generate_boot_plot: true

  # Export journal logs
  export_journal: true

# Comparison configuration
comparison:
  # Metrics to compare
  metrics:
    - virtualization_type
    - boot_time
    - security_score
    - anomaly_count
    - failed_services
    - migration_ready
    - network_config

  # Group VMs by these attributes
  group_by:
    - distribution
    - major_version

  # Highlight differences exceeding these thresholds
  difference_thresholds:
    security_score: 15  # Alert if scores differ by >15 points
    boot_time: 5.0      # Alert if boot times differ by >5 seconds

# Benchmark configuration
benchmark:
  # Timeout per tool (seconds)
  tool_timeout: 300

  # Number of iterations for averaging
  iterations: 1

  # Tools to benchmark
  tools:
    - systemd_forensic_analysis
    - migration_readiness_check
    - security_audit
    - filesystem_api_demo

  # Performance baselines (for regression detection)
  baselines:
    systemd_forensic_analysis:
      max_time: 10.0    # seconds
      max_memory: 500   # MB
    migration_readiness_check:
      max_time: 8.0
      max_memory: 300
    security_audit:
      max_time: 8.0
      max_memory: 300

# Analytics configuration
analytics:
  # Report retention (days)
  retention_days: 90

  # Historical trend analysis
  trends:
    enabled: true
    min_datapoints: 3

  # Alert thresholds
  alerts:
    security_score_drop: 10    # Alert if score drops >10 points
    new_anomalies: true        # Alert on any new anomalies
    failed_services_increase: true

  # Dashboard refresh interval (for continuous monitoring)
  refresh_interval: 3600  # seconds

# Notification configuration
notifications:
  enabled: false

  # Email notifications
  email:
    enabled: false
    smtp_server: smtp.example.com
    smtp_port: 587
    smtp_user: notifications@example.com
    smtp_password: ${SMTP_PASSWORD}  # Use environment variable
    from_address: hyper2kvm@example.com

  # Webhook notifications
  webhook:
    enabled: false
    url: https://hooks.example.com/hyper2kvm
    method: POST
    headers:
      Authorization: "Bearer ${WEBHOOK_TOKEN}"

  # Slack notifications
  slack:
    enabled: false
    webhook_url: ${SLACK_WEBHOOK_URL}
    channel: "#vm-migrations"

# VM inventory (for batch operations)
inventory:
  # VM groups for organized processing
  groups:
    production:
      - /vmware/prod-web-01.vmdk
      - /vmware/prod-db-01.vmdk
      - /vmware/prod-app-01.vmdk

    staging:
      - /vmware/stage-web-01.vmdk
      - /vmware/stage-db-01.vmdk

    development:
      - /vmware/dev-*.vmdk

  # Default group for operations
  default_group: production

# Logging configuration
logging:
  # Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  level: INFO

  # Log file location
  file: /var/log/hyper2kvm/tools.log

  # Log rotation
  rotation:
    enabled: true
    max_bytes: 10485760  # 10 MB
    backup_count: 5

  # Log format
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Integration settings
integrations:
  # Prometheus metrics export
  prometheus:
    enabled: false
    port: 9090
    metrics_path: /metrics

  # Grafana dashboard
  grafana:
    enabled: false
    dashboard_uid: hyper2kvm-tools

  # CI/CD integration
  cicd:
    # Fail build on migration readiness issues
    fail_on_not_ready: true
    # Fail build on security score below threshold
    fail_on_low_security: true
    min_security_score: 70
