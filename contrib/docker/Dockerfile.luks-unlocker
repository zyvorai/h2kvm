# Hyper2KVM LUKS Unlocker Container Image
# For Kubernetes DaemonSet deployment
#
# Build:
#   docker build -f contrib/docker/Dockerfile.luks-unlocker -t hyper2kvm/luks-unlocker:latest .
#
# Run:
#   kubectl apply -f contrib/kubernetes/daemonset.yaml

FROM python:3.11-slim

LABEL maintainer="Hyper2KVM Project"
LABEL description="LUKS auto-unlock for Kubernetes worker nodes"
LABEL version="1.0.0"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    cryptsetup \
    lvm2 \
    tpm2-tools \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy hyper2kvm package
COPY hyper2kvm/ /app/hyper2kvm/
COPY bin/hyper2kvm-luks /usr/bin/hyper2kvm-luks
COPY setup.py README.md /app/

# Install Python dependencies
RUN pip install --no-cache-dir \
    cryptography \
    hvac \
    && pip install -e /app

# Make CLI executable
RUN chmod +x /usr/bin/hyper2kvm-luks

# Create config directory
RUN mkdir -p /etc/hyper2kvm

# Security: Run as non-root when possible
# Note: For actual device unlock, privileged mode is required
# This just sets defaults for non-privileged operations
RUN useradd -m -u 1000 hyper2kvm
USER hyper2kvm

# Default command
ENTRYPOINT ["/usr/bin/hyper2kvm-luks"]
CMD ["unlock", "-v"]

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD hyper2kvm-luks status || exit 1
