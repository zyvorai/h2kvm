# Hyper2KVM TPM Auto-Enrollment Service
#
# This service runs on first boot to enroll LUKS devices with TPM2.
# After successful enrollment, it creates a marker file to prevent re-enrollment.
#
# Installation:
#   sudo cp hyper2kvm-tpm-enroll.service /etc/systemd/system/
#   sudo systemctl enable hyper2kvm-tpm-enroll.service

[Unit]
Description=Hyper2KVM TPM2 Auto-Enrollment
Documentation=https://github.com/anthropics/hyper2kvm
ConditionPathExists=!/var/lib/hyper2kvm/tpm-enrolled
After=cryptsetup.target
Before=multi-user.target

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /var/lib/hyper2kvm
ExecStart=/usr/bin/systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0+1+2+3+7 /dev/sda3
ExecStartPost=/bin/touch /var/lib/hyper2kvm/tpm-enrolled
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

# Security
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hyper2kvm

[Install]
WantedBy=multi-user.target
