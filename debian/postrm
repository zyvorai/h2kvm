#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    purge)
        # Remove user and group on purge
        if getent passwd hyper2kvm >/dev/null; then
            deluser --quiet hyper2kvm 2>/dev/null || true
        fi
        if getent group hyper2kvm >/dev/null; then
            delgroup --quiet hyper2kvm 2>/dev/null || true
        fi

        # Remove log directory on purge
        rm -rf /var/log/hyper2kvm
        ;;
esac

exit 0
