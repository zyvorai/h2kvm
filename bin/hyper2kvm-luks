"""
Hyper2KVM LUKS Auto-Unlock CLI Entry Point

This is the main executable for the hyper2kvm-luks command.
"""

import sys

# Add hyper2kvm to path if running from source
try:
    from hyper2kvm.luks.cli import main
except ImportError:
    import os
    sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    from hyper2kvm.luks.cli import main

if __name__ == '__main__':
    sys.exit(main())
