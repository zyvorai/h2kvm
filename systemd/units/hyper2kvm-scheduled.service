[Unit]
Description=Hyper2KVM Scheduled VM Repair
Documentation=man:hyper2kvm(1) https://github.com/ssahani/hyper2kvm
After=network.target libvirtd.service
Requires=libvirtd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hyper2kvm-repair-all
User=root
Group=root

# Resource limits (lower priority for scheduled tasks)
CPUSchedulingPolicy=batch
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=4

CPUQuota=50%
MemoryMax=2G
TasksMax=256

# Security hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/libvirt/images /var/log/hyper2kvm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
NoNewPrivileges=yes

# Timeout
TimeoutStartSec=0
TimeoutStopSec=30s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyper2kvm-scheduled

[Install]
WantedBy=multi-user.target
