[Unit]
Description=Hyper2KVM Socket Activation
Documentation=man:hyper2kvm(1) https://github.com/ssahani/hyper2kvm
PartOf=hyper2kvm.service

[Socket]
ListenStream=/run/hyper2kvm/repair.sock
SocketMode=0666
SocketUser=root
SocketGroup=root
Accept=no
RemoveOnStop=yes

# Socket options
Backlog=128
KeepAlive=yes
NoDelay=yes

# Trigger service on connection
Service=hyper2kvm.service

[Install]
WantedBy=sockets.target
