[Unit]
Description=Hyper2KVM Path Trigger Service
Documentation=man:hyper2kvm(1) https://github.com/ssahani/hyper2kvm
After=network.target libvirtd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hyper2kvm-path-handler
User=root
Group=root

# Resource limits
CPUQuota=25%
MemoryMax=1G
TasksMax=128

# Security
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/libvirt/images /var/log/hyper2kvm
ProtectKernelTunables=yes
ProtectKernelModules=yes
NoNewPrivileges=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyper2kvm-path-trigger
