[Unit]
Description=H2KVM VM Repair for %I
Documentation=man:h2kvm(1) https://github.com/ssahani/h2kvm
After=network.target libvirtd.service
Requires=libvirtd.service
Before=libvirt-guests.service

# Prevent multiple instances for same VM
Conflicts=h2kvm@%i.service

[Service]
Type=oneshot
# %I is the instance name (VM name or identifier)
ExecStart=/usr/local/bin/h2kvmctl --repair-vm %I
User=root
Group=root

# Resource limits
CPUSchedulingPolicy=batch
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=4

CPUQuota=50%
CPUWeight=100
MemoryMax=2G
MemoryHigh=1536M
TasksMax=256
IOWeight=100

# Security hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=h2kvm
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/libvirt/images /var/lib/h2kvm /var/log/h2kvm /run/h2kvm
ReadOnlyPaths=/usr /etc

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible

RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes

# Timeouts
TimeoutStartSec=0
TimeoutStopSec=30s

# Restart policy
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=h2kvm-%i

# Success exit codes
SuccessExitStatus=0 2

[Install]
WantedBy=multi-user.target
