[Unit]
Description=Hyper2KVM Path Monitor for VM Images
Documentation=man:hyper2kvm(1) https://github.com/ssahani/hyper2kvm
Before=hyper2kvm-path-trigger.service

[Path]
# Monitor VM image directory
PathChanged=/var/lib/libvirt/images
PathModified=/var/lib/libvirt/images

# Trigger service on changes
Unit=hyper2kvm-path-trigger.service

# Make unit persistent across reboots
MakeDirectory=yes
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
